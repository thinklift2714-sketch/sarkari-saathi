# Sarkari Saathi (सरकारी साथी) Environment Variables

# Backend Port and Host
HOST=0.0.0.0
PORT=8000

# Google Gemini API (Get free key from https://aistudio.google.com)
GEMINI_API_KEY=

# Supabase Credentials (PostgreSQL database & Auth)
SUPABASE_URL=
SUPABASE_KEY=

# Voice Services (Optional - graceful fallbacks built-in)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
OPENAI_API_KEY=

# Mode
DEMO_MODE=true

